{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "echo \"eslint deferred\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests",
    "migrate:public": "TS_NODE_TRANSPILE_ONLY=true ts-node -r tsconfig-paths/register src/cli/migrate-public.ts",
    "migrate:tenants": "TS_NODE_TRANSPILE_ONLY=true ts-node -r tsconfig-paths/register src/cli/migrate-tenants.ts",
    "seed:demo": "TS_NODE_TRANSPILE_ONLY=true ts-node -r tsconfig-paths/register src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.5.8",
    "@mikro-orm/migrations": "^6.5.8",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.5.8",
    "@mikro-orm/seeder": "^6.5.8",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "^6.4.0",
    "@wufud/contracts": "workspace:*",
    "argon2": "^0.44.0",
    "bullmq": "^5.66.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.8.2",
    "nestjs-pino": "^4.5.0",
    "nodemailer": "^7.0.11",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^20.0.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.5.8",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.45.0"
  }
}
