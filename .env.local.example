# Shared local demo credentials
DEMO_PASSWORD=WufudDemo!2026
SEED_DEMO=true

# Platform
PLATFORM_HOST=wufud.localhost
API_PORT=4005
WEB_PORT=3009

# Database
DATABASE_URL=postgresql://wufud:wufud@localhost:55432/wufud
POSTGRES_USER=wufud
POSTGRES_PASSWORD=wufud
POSTGRES_DB=wufud

# Redis
REDIS_URL=redis://localhost:56379

# Auth
JWT_ACCESS_SECRET=local-access-secret-change-me
JWT_REFRESH_SECRET=local-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# Mail (Mailpit for local capture; operator mailboxes are stored in the database)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Wufud <noreply@wufud.localhost>"

# Optional bootstrap for dynamic email / payment credentials (never committed).
# These are written into the gateway catalog, tenant instances, and email account
# tables — operators can change them later in the UI. Leave blank to skip.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=true
EMAIL_FROM=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
INVITE_TENANT_EMAIL=
INVITE_TENANT_SLUG=tenant1
INVITE_TENANT_NAME=Tenant One
WEB_PORT=3009

# Traefik sync (local noop path)
TRAEFIK_DYNAMIC_PATH=./traefik/dynamic/wufud-custom-domains.yml
